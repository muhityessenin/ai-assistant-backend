APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=18473

POSTGRES_DB=ai_assistants
POSTGRES_USER=ai_backend
POSTGRES_PASSWORD=replace_with_a_long_random_password
POSTGRES_HOST_PORT=15439
DATABASE_URL=postgres://ai_backend:replace_with_a_long_random_password@postgres:5432/ai_assistants?sslmode=disable

JWT_SECRET=replace_with_at_least_32_random_characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
PUBLIC_REGISTRATION=false

BOOTSTRAP_OWNER_EMAIL=owner@example.com
BOOTSTRAP_OWNER_PASSWORD=replace_with_at_least_12_characters
BOOTSTRAP_ORGANIZATION_NAME=Example Company

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
DEFAULT_AI_PROVIDER=openai
LLM_TIMEOUT=2m

UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_MB=50
MAX_AUDIO_MB=20
DOCUMENT_WORKERS=2
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
RAG_DEFAULT_TOP_K=8
AUTO_APPROVE_ADMIN_FEEDBACK=true

RATE_LIMIT_REQUESTS=100
CHAT_RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW=1m
CORS_ALLOWED_ORIGINS=https://frontend.example.com
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=0s
HTTP_IDLE_TIMEOUT=60s
LOG_LEVEL=info
